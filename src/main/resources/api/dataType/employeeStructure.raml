#%RAML 1.0 DataType
type: object
properties:
    name:
      type: string
      required: true
    empID:
      type: integer
      required: true
    age:
      type: integer
      required: true
    salary:
      type: number
      required: true
    isActive:
      type: boolean
      required: false
    joiningDate:
      type: date-only
      required: false
